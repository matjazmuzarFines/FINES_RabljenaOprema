# Kopiraj v .env.local in izpolni. Vrednosti najdeš v Supabase: Project Settings -> API (Data API / API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) ali legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ime Storage bucketa s slikami in (neobvezno) podmapa, v kateri so slike
NEXT_PUBLIC_SLIKE_BUCKET=Slike_rabljena_oprema
NEXT_PUBLIC_SLIKE_MAPA=
# Power Automate flow za Teams obvestilo ob novi opremi (HTTP URL sprožilca "When a Teams webhook request is received").
# SKRIVNOST: brez NEXT_PUBLIC_, ne objavljaj. Če je prazno, se obvestilo ne pošlje.
TEAMS_WEBHOOK_URL=